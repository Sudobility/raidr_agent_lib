{
  "name": "@sudobility/raidr_agent_lib",
  "version": "0.0.13",
  "description": "Business logic library for RaidrAgent with Zustand stores",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runner": {
      "types": "./dist/business/runner/index.d.ts",
      "import": "./dist/business/runner/index.js",
      "default": "./dist/business/runner/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "bunx tsc -p tsconfig.build.json",
    "build:watch": "bunx tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx eslint src/",
    "lint:fix": "bunx eslint src/ --fix",
    "format": "bunx prettier --write \"src/**/*.ts\"",
    "format:check": "bunx prettier --check \"src/**/*.ts\"",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "verify": "bun run typecheck && bun run lint && bun run test:unit && bun run build"
  },
  "keywords": [
    "raidr_agent",
    "business-logic",
    "zustand",
    "react",
    "typescript"
  ],
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@sudobility/raidr_agent_client": "^0.0.11",
    "@sudobility/raidr_agent_types": "^0.0.11",
    "@sudobility/types": "^1.9.76",
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0",
    "zod": "^4.0.0",
    "zustand": ">=5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@sudobility/raidr_agent_client": "^0.0.11",
    "@sudobility/raidr_agent_types": "^0.0.11",
    "@sudobility/types": "^1.9.76",
    "@tanstack/react-query": "~5.104.5",
    "@testing-library/react": "~16.3.3",
    "@testing-library/react-hooks": "~8.0.1",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "eslint-plugin-react-hooks": "~5.2.0",
    "globals": "~16.5.0",
    "jsdom": "~28.1.0",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12",
    "zod": "~4.6.5",
    "zustand": "~5.0.16"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/raidr_agent_lib.git"
  },
  "homepage": "https://github.com/johnqh/raidr_agent_lib#readme",
  "bugs": {
    "url": "https://github.com/johnqh/raidr_agent_lib/issues"
  },
  "dependencies": {
    "@sudobility/raidr_types": "^0.1.17"
  }
}
